{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.archagent/audit",
  "description": "Evidence-backed architecture-quality analysis for Python agent applications.",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "archagent-audit",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://archagent-mcp-1015314816960.us-central1.run.app/mcp",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {ARCHAGENT_API_KEY}",
          "variables": {
            "ARCHAGENT_API_KEY": {
              "description": "Private-beta judge credential supplied in submission testing notes.",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
